{
  "manifest_version": 3,
  "name": "Persona AI",
  "version": "1.0",
  "description": "AI-powered WhatsApp reply assistant",

  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],

  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://127.0.0.1:8000/*"
],

  "action": {
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "domInspector.js"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ]
}